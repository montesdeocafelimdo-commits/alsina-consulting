# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx...        # cliente, seguro con RLS
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx...            # SOLO server / API routes

# ── Resend ────────────────────────────────────────────
RESEND_API_KEY=re_xxxx...                        # SOLO server / API routes

# ── Site ──────────────────────────────────────────────
SITE_URL=https://alsinaar.com

# ── Mercado Pago (Fase 6 — checklist completo en README-PAGOS.md) ──
# Flag maestro. En "false" (o sin definir), todo el sitio funciona con
# lista de espera por mail — nunca se llama a la API de Mercado Pago.
PAYMENTS_ENABLED=false
# MP_ACCESS_TOKEN=APP_USR-xxxx...                # credencial privada, Tus Integraciones
# MP_PUBLIC_KEY=APP_USR-xxxx...                   # pública, se puede exponer al cliente
# MP_WEBHOOK_SECRET=xxxx...                       # "Clave secreta" del webhook en el panel de MP

# ── Informes de clientes (Fase 6.2) ───────────────────
# Hash SHA-256 de la clave de acceso de cada informe (no la clave en
# texto plano). Generarlo con:
#   node -e "console.log(require('crypto').createHash('sha256').update('LA_CLAVE').digest('hex'))"
# Placeholders actuales del proyecto (rotar antes de ir a producción y
# avisarle la clave nueva al cliente):
#   Olavarría            -> "olavarria-2026"
#   Exaltación de la Cruz -> "exaltacion-2026"
INFORME_KEY_HASH_OLAVARRIA=577df85c87205e9fabe534653c71546d4015eca5bcda6599a174d1717b864443
INFORME_KEY_HASH_EXALTACION=5554b8b822e4255bcea7668ed10e0dd9a8bd82f2f92f22e38520d19ffeeb36fd
